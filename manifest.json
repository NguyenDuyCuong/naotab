{
  "manifest_version": 3,
  "name": "Tab Explorer",
  "version": "2.0",
  "description": "Lấy, lưu và tổ chức tabs thành knowledge base cá nhân",
  "permissions": [
    "tabs",
    "storage",
    "unlimitedStorage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Tab Explorer"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}

{
  "manifest_version": 3,
  "name": "naoTab",
  "version": "0.17.0",
  "description": "Turn your browser tabs into a personal knowledge base — with context, tags, AI summaries, and a visual network graph.",
  "permissions": [
    "tabs",
    "storage",
    "unlimitedStorage",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "naoTab"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
